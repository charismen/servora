# =============================================================================
# Servora Environment Configuration
# Copy this file to `.env` and adjust values before running Docker Compose.
# =============================================================================

# Runtime environment (Development | Production)
ASPNETCORE_ENVIRONMENT=Production

# MySQL Database
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me-strong-db-password
DB_NAME=servora
MYSQL_EXTERNAL_PORT=3307

# Security (use a 32+ character random key in production)
JWT_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_ISSUER=ServoraApi
JWT_AUDIENCE=ServoraClients
# Required in Production if enabling online payment gateways or notification provider credentials (32-byte base64 or long passphrase)
SECRET_ENCRYPTION_KEY=change-me-to-a-strong-32-byte-secret-encryption-key

# Authentication & Registration
AUTH_ALLOW_PUBLIC_REGISTRATION=false

# System SMTP (used for Forgot Password, Staff Invite, Email 2FA OTP, and workspace fallback)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM_EMAIL=
EMAIL_SMTP_FROM_NAME=Servora

# Outbound Webhooks (keep false in production to block localhost/private-network SSRF targets)
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# Initial Admin Account (seeded when SEED_RUN_ON_STARTUP=true)
SEED_RUN_ON_STARTUP=true
SEED_INCLUDE_DEMO_DATA=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# Operations defaults
DEFAULT_TIMEZONE=Asia/Jakarta

# Networking & Public URLs
API_EXTERNAL_PORT=5000
WEB_EXTERNAL_PORT=3000
PUBLIC_FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
INTERNAL_API_BASE_URL=http://api:8080/api/v1
APP_HOST=localhost
