{
  "Database": {
    "db_host": "localhost",
    "db_port": 3306,
    "db_user": "root",
    "db_password": "password",
    "db_name": "servora"
  },
  "TimeZone": {
    "Default": "Asia/Jakarta"
  },
  "SeedData": {
    "RunOnStartup": false,
    "Admin": {
      "Email": "admin@example.com",
      "Password": "Admin123!",
      "FirstName": "System",
      "LastName": "Admin"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "PublicFrontendBaseUrl": "http://localhost:5173",
  "Jwt": {
    "Issuer": "ServoraApi",
    "Audience": "ServoraClients",
    "Key": "this-is-a-super-secret-key-for-jwt-authentication-in-development"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
